SMS_WEBHOOK_SECRET=""
# Verified WeChat service account. The callback URL is /api/wechat/callback.
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
WECHAT_TOKEN=""
WECHAT_CHECKIN_TEMPLATE_ID=""
# Fallback SMS and trustee contact adapter. WeChat remains the daily channel.
NOTIFICATION_WEBHOOK_URL=""
NOTIFICATION_WEBHOOK_SECRET=""
SCHEDULER_SECRET=""
